# ===========================================================================
# AI Hiring Platform - Environment Configuration Template
# Copy to .env or .env.{environment} and fill with your actual credentials.
# ===========================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Hiring Pipeline"
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Development: SQLite (default)
DATABASE_URL=sqlite:///./data/interview.db
# Staging/Production: PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Authentication & Secrets ---
# MUST be replaced with a secure random key in staging/production!
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Transactional email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-recruiter@gmail.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-recruiter@gmail.com
SMTP_FROM_NAME="Graduate Admissions"
SMTP_USE_SSL=false
SMTP_STARTTLS=true
PUBLIC_BASE_URL=http://localhost:8000

# --- AI & LLM Provider ---
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_TEMPERATURE=0.2
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Identity Verification Models ---
IDENTITY_MATCHER=sface
FACE_MATCH_THRESHOLD=0.70
SFACE_MODEL_PATH=models/face/face_recognition_sface_2021dec.onnx
YUNET_MODEL_PATH=models/face/face_detection_yunet_2023mar.onnx

# --- Voice & Audio (STT / TTS) ---
WHISPER_MODEL=small
STT_ENABLED=true
TTS_ENABLED=true
AUDIO_UPLOAD_MAX_BYTES=52428800

# --- Storage Directories ---
RESUME_UPLOAD_DIR=data/outputs/resumes
RECORDING_UPLOAD_DIR=data/outputs/interviews
IDENTITY_LOGS_DIR=data/outputs/identity_logs
JOBS_STORAGE_DIR=data/outputs/jobs
VECTOR_DB_PATH=data/processed/vector_store

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# --- Feature Flags ---
ENABLE_VOICE=true
ENABLE_TTS=true
ENABLE_IDENTITY=true
ENABLE_BACKGROUND_JOBS=true

# --- Scoring Weights ---
RESUME_WEIGHT=0.40
INTERVIEW_WEIGHT=0.60
